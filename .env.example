# Local Docker Postgres (see docker-compose.yml)
DATABASE_URL="postgresql://lorevault:lorevault@localhost:5433/lorevault?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# Optional OAuth later
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Public site URL (Vercel sets this automatically)
# AUTH_URL="http://localhost:3000"

# Optional: Vercel Blob for file image uploads in Studio/gallery
# Without this token, paste image URLs instead