    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
