generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  EDITOR
  ADMIN
}

enum FavoriteTarget {
  CHARACTER
  EPISODE
  LOCATION
  FACTION
  ARTICLE
}

model User {
  id           String       @id @default(cuid())
  name         String?
  email        String       @unique
  passwordHash String?
  image        String?
  role         Role         @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  accounts     Account[]
  sessions     Session[]
  favorites    Favorite[]
  articles     Article[]    @relation("ArticleAuthor")
  comments     Comment[]
  ratings      Rating[]
  mediaUploads MediaAsset[] @relation("MediaUploader")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Universe {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  tagline     String
  description String       @db.Text
  accent      String       @default("#c9a227")
  coverUrl    String?
  isFeatured  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  characters  Character[]
  factions    Faction[]
  locations   Location[]
  episodes    Episode[]
  articles    Article[]
  media       MediaAsset[]
}

model Character {
  id          String   @id @default(cuid())
  universeId  String
  slug        String
  name        String
  title       String?
  summary     String   @db.Text
  bio         String   @db.Text
  allegiances String[]
  imageHint   String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  universe    Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@unique([universeId, slug])
  @@index([name])
}

model Faction {
  id          String   @id @default(cuid())
  universeId  String
  slug        String
  name        String
  summary     String   @db.Text
  description String   @db.Text
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  universe    Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@unique([universeId, slug])
}

model Location {
  id          String   @id @default(cuid())
  universeId  String
  slug        String
  name        String
  region      String?
  summary     String   @db.Text
  description String   @db.Text
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  universe    Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@unique([universeId, slug])
}

model Episode {
  id          String   @id @default(cuid())
  universeId  String
  slug        String
  title       String
  season      Int
  number      Int
  synopsis    String   @db.Text
  airDate     String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  universe    Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@unique([universeId, slug])
  @@unique([universeId, season, number])
}

model Article {
  id          String   @id @default(cuid())
  universeId  String
  slug        String
  title       String
  summary     String   @db.Text
  body        String   @db.Text
  imageUrl    String?
  published   Boolean  @default(true)
  authorId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  universe    Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  author      User?    @relation("ArticleAuthor", fields: [authorId], references: [id])

  @@unique([universeId, slug])
  @@index([title])
}

model Favorite {
  id         String         @id @default(cuid())
  userId     String
  targetType FavoriteTarget
  targetId   String
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId])
}

model Comment {
  id         String         @id @default(cuid())
  userId     String
  targetType FavoriteTarget
  targetId   String
  body       String         @db.Text
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId, createdAt])
  @@index([userId])
}

model Rating {
  id         String         @id @default(cuid())
  userId     String
  targetType FavoriteTarget
  targetId   String
  score      Int
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

model MediaAsset {
  id           String         @id @default(cuid())
  universeId   String?
  targetType   FavoriteTarget
  targetId     String
  url          String
  alt          String?
  caption      String?
  isCover      Boolean        @default(false)
  uploadedById String?
  createdAt    DateTime       @default(now())
  universe     Universe?      @relation(fields: [universeId], references: [id], onDelete: SetNull)
  uploadedBy   User?          @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([universeId])
}
